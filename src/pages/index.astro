---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { company, url } from '../lib/site';

const stats = [
  { value: String(company.partnerSince), label: 'Baupartner von FAVORIT Massivhaus' },
  { value: '100 %', label: 'massive Bauweise, kein Fertigbau' },
  { value: '1', label: 'fester Ansprechpartner vom Erstgespräch bis zur Übergabe' },
];

const services = [
  { icon: 'house', title: 'Einfamilienhaus', text: 'Ihr Grundstück, Ihr Grundriss. Gemeinsam mit FAVORIT individuell geplant und massiv gemauert – vom Keller bis zum Dach.', href: 'leistungen/' },
  { icon: 'layers', title: 'Tiefbau & Rohbau', text: 'Erdarbeiten, Fundamente, Bodenplatte, Mauerwerk und Decken – von bewährten Fachbetrieben ausgeführt, von uns überwacht.', href: 'leistungen/#rohbau' },
  { icon: 'roof', title: 'Dach & Fenster', text: 'Dachstuhl, Eindeckung, Fenster und Klinkerfassade für eine dichte, langlebige Gebäudehülle.', href: 'leistungen/#rohbau' },
  { icon: 'tools', title: 'Innenausbau', text: 'Putz, Estrich, Elektro, Sanitär, Fliesen und Türen – von unserer Bauleitung vergeben und gesteuert.', href: 'leistungen/#ausbau' },
] as const;

const reasons = [
  { title: 'Familienunternehmen mit Erfahrung', text: 'Sie sprechen mit der Geschäftsführung, nicht mit einer Hotline. Entscheidungen fallen schnell und verbindlich.' },
  { title: 'Massive, solide Bauweise', text: 'Stein auf Stein gemauert, mit festen Handwerkspartnern vom Niederrhein und kontrollierten Bauabschnitten.' },
  { title: 'Individuelle Planung und Umsetzung', text: 'Grundriss, Ausstattung und Fassade entstehen gemeinsam mit Ihnen und FAVORIT Massivhaus.' },
];

const steps = [
  { title: 'Erstgespräch', text: 'Grundstück, Vorstellungen, Budget. Unverbindlich und gern bei Ihnen vor Ort.' },
  { title: 'Planung mit FAVORIT', text: 'Grundriss, Ausstattung und Leistungsumfang werden gemeinsam klar festgelegt.' },
  { title: 'Bauvorbereitung', text: 'Nach Vertragsschluss stimmen wir Termine ab und bereiten die Baustelle vor.' },
  { title: 'Bauphase', text: 'Feste Bauleitung und ein Terminplan, auf den Sie sich verlassen können.' },
  { title: 'Übergabe', text: 'Gemeinsame Abnahme, Schlüsselübergabe und ein Ansprechpartner auch danach.' },
];
---
<Base title="Start" description="Poels Massivbau GmbH aus Straelen: Familienunternehmen für Massivhäuser am Niederrhein. Baupartner von FAVORIT Massivhaus seit 2021.">
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Massivhausbau am Niederrhein</p>
      <h1>Wir bauen Ihr Zuhause.<br />Stein auf Stein.</h1>
      <p class="hero__lead">Als Familienunternehmen aus Straelen bauen wir Einfamilienhäuser in massiver Bauweise – vom Erdaushub bis zur Schlüsselübergabe, mit festen Ansprechpartnern.</p>
      <div class="btn-row">
        <a href={url('kontakt/')} class="btn btn--red">Bauvorhaben besprechen <Icon name="arrow" /></a>
        <a href={url('leistungen/')} class="btn btn--outline-light">Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Auf einen Blick">
    <div class="container trust__inner">
      <span><Icon name="shield" size={19} />Baupartner von FAVORIT Massivhaus seit {company.partnerSince}</span>
      <span><Icon name="house" size={19} />Familienunternehmen aus Straelen</span>
      <span><Icon name="pin" size={19} />Straelen · Kreis Kleve · Kreis Viersen · Niederrhein</span>
    </div>
  </section>

  <section class="stats">
    <div class="container stats__grid">
      {stats.map((s) => (
        <div class="stat"><div class="stat__value">{s.value}</div><div class="stat__label">{s.label}</div></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Leistungen</p><h2>Was wir für Sie bauen</h2></div>
        <p class="lead">Alle Gewerke vergeben, koordinieren und überwachen wir mit eigener Bauleitung – Sie haben einen Ansprechpartner für alles.</p>
      </div>
      <div class="grid grid--4">
        {services.map((s) => (
          <a href={url(s.href)} class="card card--link">
            <Icon name={s.icon} size={30} class="card__icon" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="card__more">Mehr erfahren →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="container why__grid">
      <div class="why__visual" aria-hidden="true">
        <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
          {Array.from({ length: 12 }, (_, r) =>
            Array.from({ length: 9 }, (_, c) => (
              <rect x={c * 48 - (r % 2 ? 24 : 0)} y={r * 26} width="44" height="22" fill={(r * 7 + c * 3) % 11 === 0 ? '#CC0404' : '#D6CFC5'} />
            ))
          )}
        </svg>
      </div>
      <div>
        <p class="eyebrow">Warum Poels</p>
        <h2>Ein Haus, das Ihre Enkel noch überzeugt</h2>
        <p class="why__intro">Massiv gebaut heißt: solide Statik, guter Schallschutz und hoher Werterhalt. Und weil unsere Bauleitung alle Gewerke vom Tiefbau bis zum Ausbau koordiniert und überwacht, wissen wir an jedem Tag, wie Ihr Haus wirklich steht.</p>
        <div class="why__list">
          {reasons.map((r) => (
            <div class="why__item">
              <span class="why__check"><Icon name="check" /></span>
              <div><h3>{r.title}</h3><p>{r.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="favorit">
    <div class="container favorit__inner">
      <div class="favorit__badge" aria-hidden="true"><span>FAVORIT</span><small>Massivhaus</small></div>
      <div class="favorit__text">
        <p class="favorit__kicker">Baupartner seit {company.partnerSince}</p>
        <p>Als Baupartner von FAVORIT Massivhaus verbinden wir individuelle Hausplanung und Planungssicherheit mit der Ausführung eines regionalen Bauunternehmens.</p>
      </div>
      <a href={company.partnerUrl} class="btn btn--outline-dark" target="_blank" rel="noopener">Zu FAVORIT Massivhaus</a>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="steps-head">
        <p class="eyebrow">Ablauf</p>
        <h2>Von der ersten Idee bis zum Schlüssel</h2>
        <p class="lead">Fünf Schritte, in denen Sie jederzeit wissen, was als Nächstes passiert.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="steps__num">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <a href={url('ablauf/')} class="steps__more">Ablauf im Detail →</a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--anthracite); background-image: var(--stripes-dark), linear-gradient(160deg, #1b2a38 0%, #121d28 55%, #0c141c 100%); color: #fff; }
  .hero__inner { min-height: clamp(520px, 72vh, 660px); display: flex; flex-direction: column; justify-content: center; padding-top: 72px; padding-bottom: 72px; }
  .hero__eyebrow { display: flex; align-items: center; gap: 12px; font-size: .82rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 24px; }
  .hero__eyebrow::before { content: ''; width: 42px; height: 3px; background: var(--red); }
  .hero h1 { color: #fff; max-width: 15ch; margin-bottom: 26px; }
  .hero__lead { font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; color: var(--on-dark); max-width: 40rem; margin-bottom: 40px; }
  .hero .btn { padding: 18px 30px; }

  .trust { background: var(--anthracite); border-top: 1px solid rgba(255, 255, 255, .08); color: rgba(255, 255, 255, .85); }
  .trust__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px 40px; padding-top: 22px; padding-bottom: 22px; font-size: .9rem; font-weight: 500; }
  .trust span { display: flex; align-items: center; gap: 11px; }
  .trust :global(svg) { color: var(--red); flex-shrink: 0; }

  .stats { background: var(--white); border-bottom: 1px solid var(--line); padding: clamp(48px, 6vw, 74px) 0; }
  .stats__grid { display: grid; gap: 32px 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .stat__value { font-size: clamp(2.2rem, 4vw, 2.9rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 8px; }
  .stat__label { font-size: .94rem; font-weight: 500; color: var(--muted); max-width: 18rem; }

  .card--link { color: var(--text); transition: border-color .15s, transform .15s; }
  .card--link:hover { color: var(--text); border-color: #d6cfc5; border-top-color: var(--red); transform: translateY(-2px); }
  .card--link .card__more { color: var(--red); }

  .why { padding-top: 0; }
  .why__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  .why__visual { height: 100%; min-height: 420px; background: #e8e3dc; border: 1px solid #ddd6cb; overflow: hidden; }
  .why__visual svg { width: 100%; height: 100%; }
  .why h2 { margin-bottom: 26px; }
  .why__intro { font-size: 1.06rem; line-height: 1.7; color: var(--text-2); margin-bottom: 38px; }
  .why__list { display: grid; gap: 26px; }
  .why__item { display: flex; gap: 18px; align-items: flex-start; }
  .why__check { flex-shrink: 0; width: 42px; height: 42px; display: grid; place-items: center; background: var(--anthracite); color: #fff; }
  .why__item h3 { font-size: 1.12rem; margin-bottom: 6px; }
  .why__item p { font-size: .97rem; color: var(--muted); }
  @media (max-width: 900px) {
    .why__grid { grid-template-columns: 1fr; gap: 40px; }
    .why__visual { min-height: 220px; order: 2; }
  }

  .favorit { background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 54px 0; }
  .favorit__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 28px 40px; }
  .favorit__badge { width: 150px; height: 78px; border: 1px solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
  .favorit__badge span { font-weight: 700; letter-spacing: .08em; }
  .favorit__badge small { font-size: .72rem; color: var(--muted); }
  .favorit__text { flex: 1 1 26rem; }
  .favorit__kicker { font-size: .78rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .favorit__text p:last-child { font-size: 1.06rem; font-weight: 500; line-height: 1.6; }

  .steps-head { max-width: 44rem; margin-bottom: 58px; }
  .steps-head h2 { margin-bottom: 20px; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px 20px; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  @media (max-width: 1100px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; } }
  .steps li { display: flex; flex-direction: column; gap: 14px; padding-top: 22px; border-top: 2px solid rgba(255, 255, 255, .18); }
  .steps__num { font-size: .82rem; font-weight: 700; letter-spacing: .1em; color: var(--red); }
  .steps h3 { color: #fff; font-size: 1.15rem; }
  .steps p { font-size: .91rem; line-height: 1.6; color: var(--on-dark-muted); }
  .steps__more { display: inline-block; margin-top: 44px; font-weight: 600; color: #fff; }
  .steps__more:hover { color: #fff; text-decoration: underline; }
</style>
