---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { company } from '../lib/site';

const team = [
  { name: 'Henry Poels', role: 'Geschäftsführung', text: 'Erstgespräch, Angebot und Projektentwicklung. Bauleitung für Tiefbau, Rohbau, Dach und Fenster.' },
  { name: 'David Pütz', role: 'Bauleitung', text: 'Bauleitung für den Innenausbau: Putz, Elektro, Sanitär, Estrich und Fliesen.' },
];

const values = [
  { title: 'Verlässlich', text: 'Was wir zusagen, halten wir ein – bei Qualität, Terminen und Kosten.' },
  { title: 'Persönlich', text: 'Sie haben feste Ansprechpartner, die Ihr Projekt kennen.' },
  { title: 'Regional', text: 'Wir sind in Straelen zu Hause und arbeiten mit Betrieben vom Niederrhein.' },
];
---
<Base title="Über uns" description="Poels Massivbau GmbH: Familienunternehmen aus Straelen für Massivbau, Bauleitung und Projektentwicklung am Niederrhein.">
  <PageHero
    crumb="Über uns"
    title="Ein Familienunternehmen aus Straelen"
    lead="Wir bauen Häuser, in denen Familien zu Hause sind – und führen unser Unternehmen selbst als Familie."
  />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Wer wir sind</p>
        <h2>Massivbau mit Handschlagqualität</h2>
        <p class="split__text">Die {company.name} ist ein inhabergeführtes Bauunternehmen mit Sitz in Straelen am Niederrhein. Wir realisieren Ein- und Mehrfamilienhäuser in massiver Bauweise, übernehmen die Bauleitung für Bauherren und Investoren und entwickeln eigene Projekte – seit [JAHR].</p>
        <p class="split__text">Unsere Stärke ist die Bauleitung: Wir vergeben alle Gewerke an bewährte Fachbetriebe aus der Region, stimmen die Termine ab und überwachen jeden Bauabschnitt. So haben Sie einen Ansprechpartner statt vieler.</p>
      </div>
      <Photo label="Team / Büro Straelen" height="460px" />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="team">
        <div>
          <p class="eyebrow">Ihre Ansprechpartner</p>
          <h2 class="team__h2">Zwei Namen, die Sie am Bau erreichen</h2>
          <p class="team__text">Bei uns führt kein Weg über eine Hotline. Sie haben vom ersten Gespräch bis zur Abnahme dieselben Ansprechpartner.</p>
        </div>
        <div class="team__people">
          {team.map((p) => (
            <div>
              <Photo label="Porträt" height="220px" />
              <h3 class="person__name">{p.name}</h3>
              <p class="person__role">{p.role}</p>
              <p class="person__text">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Wofür wir stehen</p>
      <div class="grid grid--3" style="margin-top:8px">
        {values.map((v) => <div class="tile"><h3>{v.title}</h3><p>{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .team { display: grid; grid-template-columns: 1fr 1.35fr; gap: 64px; align-items: center; padding: clamp(28px, 4.5vw, 62px); background: var(--white); border: 1px solid var(--line); }
  .team__h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin-bottom: 20px; }
  .team__text { font-size: 1.03rem; line-height: 1.7; color: var(--muted); }
  .team__people { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 24px; }
  .person__name { font-size: 1.18rem; margin: 16px 0 4px; }
  .person__role { font-size: .88rem; font-weight: 500; color: var(--red); margin-bottom: 10px; }
  .person__text { font-size: .88rem; color: var(--muted); }
  @media (max-width: 900px) { .team { grid-template-columns: 1fr; gap: 36px; } }
</style>
