---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { company } from '../lib/site';

const team = [
  { initials: 'HP', name: 'Henry Poels', role: 'Geschäftsführung', text: 'Erstgespräch und Angebot, Bauleitung für Tiefbau, Rohbau, Dach und Fenster.' },
  { initials: 'DP', name: 'David Pütz', role: 'Bauleitung', text: 'Bauleitung für den Innenausbau: Putz, Elektro, Sanitär, Estrich und Fliesen.' },
];

const values = [
  { title: 'Verlässlich', text: 'Was wir zusagen, halten wir ein – bei Qualität, Terminen und Kosten.' },
  { title: 'Persönlich', text: 'Sie haben feste Ansprechpartner, die Ihr Projekt kennen.' },
  { title: 'Regional', text: 'Wir sind in Straelen zu Hause und arbeiten mit Betrieben vom Niederrhein.' },
];
---
<Base title="Über uns" description="Poels Massivbau GmbH: Familienunternehmen aus Straelen und Baupartner von FAVORIT Massivhaus seit 2021.">
  <PageHero
    crumb="Über uns"
    title="Ein Familienunternehmen aus Straelen"
    lead="Wir bauen Häuser, in denen Familien zu Hause sind – und führen unser Unternehmen selbst als Familie."
  />

  <section class="section">
    <div class="container about">
      <div class="prose">
        <p class="eyebrow">Wer wir sind</p>
        <h2 class="about__h2">Massivbau mit Handschlagqualität</h2>
        <p>Die {company.name} ist ein inhabergeführtes Bauunternehmen mit Sitz in Straelen am Niederrhein. Wir bauen massive Einfamilienhäuser – solide, wertbeständig und individuell nach den Wünschen unserer Bauherren.</p>
        <p>Unsere Stärke ist die Bauleitung: Wir vergeben alle Gewerke – vom Tiefbau über Rohbau, Dach und Fenster bis zum Innenausbau – an bewährte Fachbetriebe aus der Region, stimmen die Termine ab und überwachen jeden Bauabschnitt. So haben Sie einen Ansprechpartner statt vieler.</p>
        <h2>Partner von FAVORIT Massivhaus</h2>
        <p>Seit {company.partnerSince} sind wir fester Baupartner der FAVORIT Massivhaus GmbH &amp; Co. KG. FAVORIT steht für individuell geplante Massivhäuser, wir für die Umsetzung vor Ort – mit kurzen Wegen und festen Ansprechpartnern.</p>
      </div>
      <aside class="facts">
        <dl>
          <div><dt>Sitz</dt><dd>{company.city}, Niederrhein</dd></div>
          <div><dt>Bauweise</dt><dd>Massivbau</dd></div>
          <div><dt>Baupartner FAVORIT</dt><dd>seit {company.partnerSince}</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="team">
        <div>
          <p class="eyebrow">Ihre Ansprechpartner</p>
          <h2 class="team__h2">Zwei Namen, die Sie am Bau erreichen</h2>
          <p class="team__text">Bei uns führt kein Weg über eine Hotline. Sie haben vom ersten Gespräch bis zur Abnahme dieselben Ansprechpartner.</p>
        </div>
        <div class="team__people">
          {team.map((p) => (
            <div class="person">
              <div class="person__avatar" aria-hidden="true">{p.initials}</div>
              <h3>{p.name}</h3>
              <p class="person__role">{p.role}</p>
              <p class="person__text">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Wofür wir stehen</p>
      <div class="grid grid--3" style="margin-top:8px">
        {values.map((v) => <div class="tile"><h3>{v.title}</h3><p>{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about { display: grid; gap: 64px; grid-template-columns: minmax(0, 1fr) 19rem; align-items: start; }
  .about__h2 { margin-top: 0 !important; font-size: clamp(1.8rem, 3.2vw, 2.5rem) !important; letter-spacing: -0.025em !important; }
  .facts { background: var(--anthracite); color: #fff; padding: 30px; border-top: 3px solid var(--red); }
  .facts dl { margin: 0; }
  .facts div { padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, .12); }
  .facts div:last-child { border-bottom: 0; }
  .facts dt { font-size: .74rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .55); }
  .facts dd { margin: 4px 0 0; font-size: 1.12rem; font-weight: 600; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; gap: 40px; } }

  .team { display: grid; grid-template-columns: 1fr 1.35fr; gap: 64px; align-items: center; padding: clamp(28px, 4.5vw, 62px); background: var(--white); border: 1px solid var(--line); }
  .team__h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin-bottom: 20px; }
  .team__text { font-size: 1.03rem; line-height: 1.7; color: var(--muted); }
  .team__people { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 24px; }
  .person__avatar {
    height: 180px; display: grid; place-items: center; margin-bottom: 16px;
    background: var(--anthracite); background-image: var(--stripes-dark);
    color: #fff; font-size: 2.6rem; font-weight: 700; letter-spacing: .02em;
  }
  .person h3 { font-size: 1.18rem; margin-bottom: 4px; }
  .person__role { font-size: .88rem; font-weight: 500; color: var(--red); margin-bottom: 10px; }
  .person__text { font-size: .88rem; color: var(--muted); }
  @media (max-width: 900px) { .team { grid-template-columns: 1fr; gap: 36px; } }
</style>
