---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';

const own = [
  { icon: 'layers', title: 'Tiefbau & Erdarbeiten', text: 'Baugrube, Bodenaushub, Fundamente, Grundleitungen und Entwässerung.' },
  { icon: 'house', title: 'Rohbau', text: 'Bodenplatte oder Keller, massives Mauerwerk, Decken und Treppen – maßgenau nach Plan.' },
  { icon: 'roof', title: 'Dach', text: 'Dachstuhl, Dämmung, Eindeckung und Dachentwässerung.' },
  { icon: 'shield', title: 'Fenster & Klinkerfassade', text: 'Fenster, Haustür und Verblendmauerwerk für eine dichte, wärmegedämmte Hülle.' },
] as const;

const role = [
  { title: 'Vergabe', text: 'Wir holen Angebote ein und beauftragen bewährte Fachbetriebe aus der Region.' },
  { title: 'Terminplanung', text: 'Ein Bauzeitenplan, in dem jedes Gewerk zur richtigen Zeit auf der Baustelle ist.' },
  { title: 'Bauüberwachung', text: 'Regelmäßige Kontrollen und Abnahmen jedes Bauabschnitts durch unsere Bauleitung.' },
  { title: 'Ein Ansprechpartner', text: 'Sie haben einen festen Bauleiter statt vieler einzelner Handwerker.' },
];

const ausbau = [
  { title: 'Innen- und Fassadenputz', text: 'Saubere Oberflächen als Grundlage für alles, was danach kommt.' },
  { title: 'Estrich', text: 'Fachgerecht eingebracht und mit der Haustechnik abgestimmt.' },
  { title: 'Elektro', text: 'Installation nach Ihren Wünschen, abgestimmt auf die Bemusterung.' },
  { title: 'Sanitär und Heizung', text: 'Bäder und Haustechnik von eingespielten Fachbetrieben.' },
  { title: 'Fliesen', text: 'Bäder, Böden und Wandflächen in der gewählten Ausstattung.' },
  { title: 'Innentüren', text: 'Zum Abschluss eingebaut – damit Ihr Haus bezugsfertig ist.' },
];
---
<Base title="Leistungen" description="Einfamilienhäuser in Massivbauweise: Bauleitung aus einer Hand: Wir vergeben, koordinieren und überwachen alle Gewerke von Tiefbau bis Innenausbau mit Fachbetrieben aus der Region.">
  <PageHero
    crumb="Leistungen"
    title="Alles für Ihr Massivhaus – aus einer Hand"
    lead="Vom Erdaushub bis zur Schlüsselübergabe: Wir vergeben alle Gewerke an bewährte Fachbetriebe, koordinieren die Termine und überwachen jeden Bauabschnitt mit eigener Bauleitung."
  />

  <section class="section">
    <div class="container detail">
      <div>
        <p class="eyebrow">Mit FAVORIT Massivhaus</p>
        <h2>Einfamilienhaus</h2>
        <p class="detail__text">Ihr Grundstück, Ihr Grundriss, Ihre Ausstattung. Gemeinsam mit unserem Partner FAVORIT Massivhaus planen Sie Ihr Haus individuell – wir bauen es vor Ort in massiver Bauweise und begleiten Sie mit fester Bauleitung bis zum Einzug.</p>
        <ul class="checks">
          <li>Individuelle Grundrissplanung mit FAVORIT</li>
          <li>Klare Baubeschreibung und festgelegter Leistungsumfang</li>
          <li>Keller oder Bodenplatte, Klinker oder Putz – Ihre Wahl</li>
          <li>Bemusterung von Fenstern, Böden, Bad und Türen</li>
        </ul>
        <div class="btn-row" style="margin-top:36px"><a href={url('kontakt/')} class="btn btn--red">Bauvorhaben besprechen <Icon name="arrow" /></a></div>
      </div>
      <div class="detail__visual" aria-hidden="true">
        <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
          {Array.from({ length: 16 }, (_, r) =>
            Array.from({ length: 9 }, (_, c) => (
              <rect x={c * 48 - (r % 2 ? 24 : 0)} y={r * 26} width="44" height="22" fill={(r * 5 + c * 2) % 13 === 0 ? '#CC0404' : '#D6CFC5'} />
            ))
          )}
        </svg>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Unsere Aufgabe</p><h2>Wir steuern Ihre Baustelle</h2></div>
        <p class="lead">Die Arbeiten führen erfahrene Fachbetriebe aus. Wir sorgen dafür, dass alles zusammenpasst – zur richtigen Zeit, in der richtigen Qualität.</p>
      </div>
      <div class="grid grid--4">
        {role.map((r) => <div class="tile tile--dark"><h3>{r.title}</h3><p>{r.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section--white" id="rohbau">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Unter unserer Bauleitung</p><h2>Die Gebäudehülle</h2></div>
        <p class="lead">Fundament, Wände, Dach und Fenster entscheiden über die Qualität eines Hauses für Jahrzehnte. Deshalb überwachen wir diese Gewerke besonders eng – ausgeführt von Fachbetrieben, mit denen wir eingespielt sind.</p>
      </div>
      <div class="grid grid--4">
        {own.map((g) => (
          <div class="card"><Icon name={g.icon} size={30} class="card__icon" /><h3>{g.title}</h3><p>{g.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="ausbau">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Unter unserer Bauleitung</p><h2>Innenausbau mit festen Partnern</h2></div>
        <p class="lead">Vergabe, Terminplanung und Qualitätskontrolle liegen bei unserer Bauleitung. Sie haben einen Ansprechpartner statt vieler.</p>
      </div>
      <div class="grid grid--3">
        {ausbau.map((a) => <div class="tile tile--white"><h3>{a.title}</h3><p>{a.text}</p></div>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .detail { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  .detail h2 { margin-bottom: 22px; }
  .detail__text { font-size: 1.06rem; line-height: 1.7; color: var(--text-2); margin-bottom: 30px; }
  .detail__visual { min-height: 440px; height: 100%; background: #e8e3dc; border: 1px solid #ddd6cb; overflow: hidden; }
  .detail__visual svg { width: 100%; height: 100%; }
  @media (max-width: 900px) {
    .detail { grid-template-columns: 1fr; gap: 40px; }
    .detail__visual { min-height: 200px; }
  }
</style>
