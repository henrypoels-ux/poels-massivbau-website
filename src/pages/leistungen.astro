---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { url } from '../lib/site';

const inklusive = [
  { title: 'Feste Bauleitung', text: 'Ein Bauleiter, den Sie kennen und der regelmäßig auf Ihrer Baustelle ist.' },
  { title: 'Digitales Bautagebuch', text: 'Fotos und Baufortschritt dokumentiert – auch wenn Sie nicht vorbeikommen können.' },
  { title: 'Terminplan', text: 'Ein Bauzeitenplan, in dem jedes Gewerk zur richtigen Zeit auf der Baustelle ist.' },
  { title: 'Bemusterung', text: 'Fenster, Türen, Böden, Fliesen und Sanitär gemeinsam beim Fachhändler aussuchen.' },
  { title: 'Regionale Partner', text: 'Handwerksbetriebe vom Niederrhein, mit denen wir seit Jahren zusammenarbeiten.' },
  { title: 'Abnahme & Gewährleistung', text: 'Gemeinsames Protokoll, vollständige Unterlagen, Ansprechpartner auch danach.' },
];
---
<Base title="Leistungen" description="Einfamilienhäuser, Mehrfamilienhäuser, reine Bauleitung und Projektentwicklung: Poels Massivbau aus Straelen übernimmt so viel, wie Sie abgeben möchten.">
  <PageHero
    crumb="Leistungen"
    title="So viel Bauleistung, wie Sie abgeben möchten"
    lead="Schlüsselfertig bauen, nur die Bauleitung abgeben oder ein Projekt von Grund auf entwickeln. Wir sagen Ihnen vorher, was Sie das kostet."
  />

  <nav class="jump" aria-label="Leistungen">
    <div class="container jump__inner">
      <a href="#einfamilienhaus">Einfamilienhaus</a>
      <a href="#mehrfamilienhaus">Mehrfamilienhaus</a>
      <a href="#bauleitung">Bauleitung</a>
      <a href="#projektentwicklung">Projektentwicklung</a>
    </div>
  </nav>

  <section class="section" id="einfamilienhaus">
    <div class="container split">
      <div>
        <p class="eyebrow">Schlüsselfertig</p>
        <h2>Einfamilienhaus</h2>
        <p class="split__text">Ihr Grundriss, Ihre Ausstattung, Ihr Termin. Wir planen mit Ihnen, koordinieren die Genehmigung und lassen massiv bauen – Sie ziehen in ein Haus, an dem nichts mehr fehlt.</p>
        <ul class="checks">
          <li>Individuelle Grundrissplanung mit dem Architekten</li>
          <li>Angebot mit detaillierter Baubeschreibung</li>
          <li>Keller oder Bodenplatte, Klinker oder Putz – Ihre Wahl</li>
          <li>Bemusterung von Fenstern, Böden, Bad und Türen</li>
        </ul>
        <div class="btn-row" style="margin-top:34px"><a href={url('referenzen/')} class="btn btn--red">Beispielprojekte ansehen <Icon name="arrow" /></a></div>
      </div>
      <Photo label="fertiges Einfamilienhaus" height="480px" />
    </div>
  </section>

  <section class="section" id="mehrfamilienhaus" style="padding-top:0">
    <div class="container split split--reverse">
      <Photo label="Mehrfamilienhaus" height="440px" />
      <div>
        <p class="eyebrow">Wohnen und Kapitalanlage</p>
        <h2>Mehrfamilienhaus</h2>
        <p class="split__text">Zwei oder mehr Wohneinheiten – für die eigene Familie, zur Vermietung oder als Kapitalanlage. Wir kalkulieren mit Ihnen Baukosten und Ertrag, bevor Sie sich binden.</p>
        <ul class="dots">
          <li>Wirtschaftlichkeitsbetrachtung vor Vertragsschluss</li>
          <li>Schall- und Brandschutz nach Landesbauordnung NRW</li>
          <li>Abgeschlossenheit und Teilung auf Wunsch</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--white focus-block" id="bauleitung">
    <div class="container split">
      <div>
        <p class="eyebrow">Als Dienstleistung</p>
        <h2>Reine Bauleitung</h2>
        <p class="split__text">Sie haben Grundstück, Planung und vielleicht schon eigene Handwerker – aber nicht die Zeit oder Erfahrung, die Baustelle zu führen? Dann übernehmen wir genau das: für private Bauherren, Investoren und Architekturbüros.</p>
        <div class="grid grid--2 minis">
          <div class="mini"><h3>Vergabe</h3><p>Angebote einholen, vergleichen, Fachbetriebe beauftragen.</p></div>
          <div class="mini"><h3>Terminplanung</h3><p>Bauzeitenplan erstellen und alle Gewerke takten.</p></div>
          <div class="mini"><h3>Bauüberwachung</h3><p>Regelmäßige Kontrollen, Mängel erkennen, bevor sie teuer werden.</p></div>
          <div class="mini"><h3>Abnahmen</h3><p>Abnahme jedes Gewerks mit Protokoll und Dokumentation.</p></div>
        </div>
        <div class="btn-row" style="margin-top:30px"><a href={url('kontakt/')} class="btn btn--red">Bauleitung anfragen <Icon name="arrow" /></a></div>
      </div>
      <Photo label="Bauleiter auf der Baustelle" height="520px" />
    </div>
  </section>

  <section class="section section--white focus-block" id="projektentwicklung" style="padding-top:0">
    <div class="container split split--reverse">
      <Photo label="Grundstück / Projektplanung" height="480px" />
      <div>
        <p class="eyebrow">Von Grund auf</p>
        <h2>Projektentwicklung</h2>
        <p class="split__text">Vom Grundstück bis zum vermieteten oder verkauften Objekt: Wir prüfen Standort und Wirtschaftlichkeit, entwickeln das Konzept, steuern Planung und Genehmigung und setzen das Projekt mit eigener Bauleitung um.</p>
        <ol class="phases">
          <li><strong>Standort & Machbarkeit</strong><span>Grundstück, Baurecht, Wirtschaftlichkeit</span></li>
          <li><strong>Konzept & Planung</strong><span>Nutzung, Wohnungsmix, Entwurf mit dem Architekten</span></li>
          <li><strong>Genehmigung & Kalkulation</strong><span>Bauantrag, Ausschreibung, Kostensicherheit</span></li>
          <li><strong>Umsetzung</strong><span>Bauleitung bis zur Übergabe</span></li>
        </ol>
        <div class="btn-row" style="margin-top:30px"><a href={url('kontakt/')} class="btn btn--red">Projekt besprechen <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><p class="eyebrow">Immer inklusive</p><h2>Das gehört bei uns nicht auf die Nachtragsliste</h2></div>
      </div>
      <div class="grid grid--3">
        {inklusive.map((t) => <div class="tile tile--white"><h3>{t.title}</h3><p>{t.text}</p></div>)}
      </div>
    </div>
  </section>

  <CtaBand title="Sagen Sie uns, was Sie vorhaben – wir sagen Ihnen, was es kostet." text="Ein Anruf oder eine kurze Nachricht genügt für die erste Einschätzung." />
</Base>

<style>
  .jump { background: var(--white); border-bottom: 1px solid var(--line); position: sticky; top: 96px; z-index: 10; }
  .jump__inner { display: flex; gap: 8px 32px; flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; }
  .jump a { font-size: .9rem; font-weight: 600; color: var(--text); }
  .jump a:hover { color: var(--red); }
  @media (max-width: 900px) { .jump { position: static; } }
  section[id] { scroll-margin-top: 170px; }

  .minis { gap: 16px; }
  .phases { list-style: none; margin: 0; padding: 0; counter-reset: p; display: grid; gap: 0; }
  .phases li { counter-increment: p; display: grid; grid-template-columns: 2.5rem 1fr; padding: 14px 0; border-top: 1px solid var(--line); }
  .phases li::before { content: counter(p, decimal-leading-zero); grid-row: span 2; font-size: .82rem; font-weight: 700; color: var(--red); padding-top: 3px; }
  .phases strong { font-weight: 600; }
  .phases span { font-size: .9rem; color: var(--muted); }
</style>
