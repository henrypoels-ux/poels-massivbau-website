---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';

// Platzhalter – Projekte, Fotos und Texte folgen.
const projects = [
  { typ: 'Einfamilienhaus', ort: 'Geldern-Veert' },
  { typ: 'Doppelhaus', ort: 'Neuss-Uedesheim' },
  { typ: 'Mehrfamilienhaus', ort: 'Essen-Frillendorf' },
  { typ: 'Einfamilienhaus', ort: 'Xanten' },
  { typ: 'Einfamilienhaus', ort: 'Kerken' },
  { typ: 'Bauleitung', ort: '[Ort]' },
];
const filters = ['Alle Projekte', 'Einfamilienhaus', 'Mehrfamilienhaus', 'Bauleitung', 'Projektentwicklung'];
---
<Base title="Referenzen" description="Referenzen der Poels Massivbau GmbH: Einfamilienhäuser, Mehrfamilienhäuser und Bauleitungsprojekte am Niederrhein und in NRW.">
  <PageHero
    crumb="Referenzen"
    title="Häuser, die stehen. Nicht nur Renderings."
    lead="Eine Auswahl unserer Bauvorhaben am Niederrhein und in NRW. Auf Wunsch zeigen wir Ihnen eine laufende Baustelle in Ihrer Nähe."
  />

  <section class="section">
    <div class="container">
      <div class="filter">
        <div class="filter__chips">
          {filters.map((f, i) => <button type="button" class:list={['chip', { 'is-active': i === 0 }]} data-filter={i === 0 ? '' : f}>{f}</button>)}
        </div>
        <span class="filter__count">[ANZAHL] Projekte</span>
      </div>
      <div class="grid grid--3 refs">
        {projects.map((p) => (
          <article class="ref" data-typ={p.typ}>
            <Photo label={p.ort} height="260px" />
            <div class="ref__body">
              <p class="ref__typ">{p.typ}</p>
              <h2>{p.ort}</h2>
              <p class="ref__text">[Kurzbeschreibung des Projekts – Bauweise, Fassade, Besonderheiten]</p>
              <div class="ref__facts">
                <div><span>Wohnfläche</span><strong>[m²]</strong></div>
                <div><span>Fertigstellung</span><strong>[Jahr]</strong></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="visit">
    <div class="container visit__inner">
      <div>
        <h2>Ihr Projekt könnte das nächste hier sein.</h2>
        <p>Wir zeigen Ihnen gern eine laufende Baustelle, damit Sie unsere Arbeit vor der Entscheidung sehen.</p>
      </div>
      <a href={url('kontakt/')} class="btn btn--white">Besichtigung anfragen <Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.ref');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.toggle('is-active', c === chip));
    const f = chip.dataset.filter;
    cards.forEach((card) => { card.hidden = !!f && card.dataset.typ !== f; });
  }));
</script>

<style>
  .filter { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 36px; }
  .filter__chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { font: inherit; font-size: .88rem; font-weight: 600; padding: 10px 18px; border: 1px solid var(--line); background: var(--white); color: var(--text); cursor: pointer; border-radius: var(--radius); }
  .chip:hover { border-color: var(--anthracite); }
  .chip.is-active { background: var(--anthracite); border-color: var(--anthracite); color: #fff; }
  .filter__count { font-size: .9rem; color: var(--muted); }

  .ref { background: var(--white); border: 1px solid var(--line); }
  .ref[hidden] { display: none; }
  .ref :global(.photo) { border: 0; }
  .ref__body { padding: 26px 26px 30px; }
  .ref__typ { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ref h2 { font-size: 1.35rem; letter-spacing: -0.01em; margin-bottom: 14px; }
  .ref__text { font-size: .91rem; color: var(--muted); margin-bottom: 18px; }
  .ref__facts { display: flex; gap: 22px; padding-top: 16px; border-top: 1px solid var(--line); }
  .ref__facts span { display: block; font-size: .72rem; font-weight: 500; color: #9a9489; margin-bottom: 3px; }
  .ref__facts strong { font-size: .91rem; font-weight: 600; }

  .visit { background: var(--anthracite); color: #fff; padding: clamp(56px, 7vw, 80px) 0; }
  .visit__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .visit h2 { color: #fff; font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 12px; }
  .visit p { color: var(--on-dark); max-width: 38rem; }
</style>
