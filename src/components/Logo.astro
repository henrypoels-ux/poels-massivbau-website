---
// Original-Logo aus _Marketing/Logo rot.svg (auf den Inhalt zugeschnitten).
// public/logo.svg = rot, public/logo-weiss.svg = weiß für dunkle Flächen.
import { url } from '../lib/site';
interface Props { light?: boolean; width?: number }
const { light = false, width = 150 } = Astro.props;
const ratio = 914.2 / 1944.1;
---
<img
  src={url(light ? 'logo-weiss.svg' : 'logo.svg')}
  alt="Poels Massivbau GmbH"
  width={width}
  height={Math.round(width * ratio)}
  class="logo"
/>
