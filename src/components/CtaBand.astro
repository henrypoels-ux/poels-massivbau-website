---
import Icon from './Icon.astro';
import { company, url } from '../lib/site';
interface Props { title?: string; text?: string }
const {
  title = 'Grundstück gefunden? Dann lassen Sie uns sprechen.',
  text = 'Schicken Sie uns Ihre Vorstellungen – Sie erhalten eine erste Einschätzung, ob und wie sich Ihr Vorhaben umsetzen lässt.',
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div class="cta__text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a href={company.phoneHref} class="btn btn--white"><Icon name="phone" />{company.phone}</a>
      <a href={url('kontakt/')} class="btn btn--outline-light">Kontaktformular</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--red); background-image: var(--stripes-light); color: #fff; padding: clamp(64px, 8vw, 92px) 0; }
  .cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2.5rem 4rem; }
  .cta__text { max-width: 44rem; }
  .cta h2 { color: #fff; font-size: clamp(1.75rem, 3.2vw, 2.6rem); margin-bottom: 18px; }
  .cta p { font-size: 1.1rem; color: rgba(255, 255, 255, .9); }
  .cta__actions { display: flex; flex-direction: column; gap: 14px; }
  .cta .btn--outline-light { border-color: rgba(255, 255, 255, .55); }
  @media (max-width: 560px) { .cta__actions { width: 100%; } }
</style>
